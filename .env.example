# Copy to .env.local and fill in for the app you are building.
# Do not commit .env.local. This file has placeholders only.

# Brand. These override app.config.json in the browser.
VITE_APP_NAME=Your App
VITE_APP_SHORT_NAME=Your App
VITE_APP_TAGLINE=CRM workspace
VITE_APP_SUPPORT_EMAIL=

# Base44 connection. The ClientHub hand copy did not include an app id,
# a client-rainbow-core-flow URL, a functions version, or any secret.
# After `base44 link`, the app id is the one in the Builder URL
# (app.base44.com/apps/<id>/...). The app base URL is the published
# host for this app, for example https://<your-app>.base44.app
VITE_BASE44_APP_ID=
VITE_BASE44_APP_BASE_URL=
VITE_BASE44_FUNCTIONS_VERSION=
