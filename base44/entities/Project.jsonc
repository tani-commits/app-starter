{
  "name": "Project",
  "type": "object",
  "description": "A delivery project scoped to a ClientAccount.",
  "properties": {
    "account_id": {
      "type": "string",
      "description": "Owning ClientAccount id"
    },
    "deal_id": {
      "type": "string",
      "description": "Originating Deal id (if won)"
    },
    "name": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "planning",
        "active",
        "on_hold",
        "completed",
        "cancelled"
      ],
      "default": "planning"
    },
    "owner_id": {
      "type": "string",
      "description": "User id responsible"
    },
    "start_date": {
      "type": "string",
      "format": "date"
    },
    "end_date": {
      "type": "string",
      "format": "date"
    },
    "members": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "User ids on the project team"
    },
    "progress": {
      "type": "number",
      "default": 0,
      "description": "0-100 completion"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "account_id",
    "name"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.account_id": {
            "$in": "{{user.data.account_ids}}"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$and": [
        {
          "data.account_id": {
            "$in": "{{user.data.account_ids}}"
          }
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "manager"
              }
            },
            {
              "user_condition": {
                "role": "member"
              }
            },
            {
              "user_condition": {
                "role": "agent"
              }
            }
          ]
        }
      ]
    },
    "update": {
      "$and": [
        {
          "data.account_id": {
            "$in": "{{user.data.account_ids}}"
          }
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "manager"
              }
            },
            {
              "user_condition": {
                "role": "member"
              }
            },
            {
              "user_condition": {
                "role": "agent"
              }
            }
          ]
        }
      ]
    },
    "delete": {
      "$and": [
        {
          "data.account_id": {
            "$in": "{{user.data.account_ids}}"
          }
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "manager"
              }
            }
          ]
        }
      ]
    }
  }
}