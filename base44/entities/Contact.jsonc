{
  "name": "Contact",
  "type": "object",
  "description": "A person belonging to a ClientAccount.",
  "properties": {
    "account_id": {
      "type": "string",
      "description": "Owning ClientAccount id"
    },
    "first_name": {
      "type": "string"
    },
    "last_name": {
      "type": "string"
    },
    "email": {
      "type": "string",
      "format": "email"
    },
    "phone": {
      "type": "string"
    },
    "title": {
      "type": "string",
      "description": "Job title"
    },
    "company": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "archived"
      ],
      "default": "active"
    },
    "owner_id": {
      "type": "string",
      "description": "User id responsible for this contact"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "enriched_data": {
      "type": "object",
      "default": {},
      "description": "Structured enrichment output pending human approval"
    },
    "enrichment_status": {
      "type": "string",
      "enum": [
        "none",
        "pending_review",
        "approved"
      ],
      "default": "none"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "account_id",
    "first_name"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.account_id": {
            "$in": "{{user.data.account_ids}}"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$and": [
        {
          "data.account_id": {
            "$in": "{{user.data.account_ids}}"
          }
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "manager"
              }
            },
            {
              "user_condition": {
                "role": "member"
              }
            },
            {
              "user_condition": {
                "role": "agent"
              }
            }
          ]
        }
      ]
    },
    "update": {
      "$and": [
        {
          "data.account_id": {
            "$in": "{{user.data.account_ids}}"
          }
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "manager"
              }
            },
            {
              "user_condition": {
                "role": "member"
              }
            },
            {
              "user_condition": {
                "role": "agent"
              }
            }
          ]
        }
      ]
    },
    "delete": {
      "$and": [
        {
          "data.account_id": {
            "$in": "{{user.data.account_ids}}"
          }
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "manager"
              }
            }
          ]
        }
      ]
    }
  }
}